# Built from web-visualizer/ at packaging time, never committed.
android-app/app/src/main/assets/visualizer/
# Wrapper JAR is generated locally; see docs/android_build.md
android-app/gradle/wrapper/gradle-wrapper.jar

# native build output
*.o
*.so
aura_test
aura_test_asan

# editors / OS
.idea/
.vscode/
.DS_Store
