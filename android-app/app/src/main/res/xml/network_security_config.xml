<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext is permitted ONLY for the edge agent on the local mesh.
        Field deployments run the agent on a private Wi-Fi island where
        provisioning a public CA chain is impractical; everything leaving that
        island (cloud sync) goes over HTTPS + WireGuard and is not listed here.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.8.0.1</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">edge-agent.local</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
